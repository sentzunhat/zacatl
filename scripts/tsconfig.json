{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "rootDir": "..",
    "noEmit": true,
    "skipLibCheck": true,
    "useUnknownInCatchVariables": false,
    "strict": false,
    "strictNullChecks": true,
    "paths": {
      "@zacatl/service": ["../src/service/index.ts"],
      "@zacatl/third-party/fastify": ["../src/third-party/fastify.ts"],
      "@zacatl/utils/configuration": ["../src/utils/configuration.ts"],
      "@zacatl/third-party/dependency-injection": ["../src/third-party/dependency-injection.ts"],
      "@zacatl/error": ["../src/error.ts"],
      "@zacatl/third-party/localization": ["../src/third-party/localization.ts"],
      "@zacatl/logs": ["../src/logs.ts"],
      "@zacatl/utils": ["../src/utils.ts"],
      "@zacatl/third-party": ["../src/third-party.ts"],
      "@zacatl/third-party/uuid": ["../src/third-party/uuid.ts"],
      "@zacatl/third-party/i18n": ["../src/third-party/i18n.ts"],
      "@zacatl/third-party/pino": ["../src/third-party/pino.ts"],
      "@zacatl/third-party/js-yaml": ["../src/third-party/js-yaml.ts"],
      "@zacatl/third-party/zod": ["../src/third-party/zod.ts"],
      "@zacatl/third-party/eslint-plugins": ["../src/third-party/eslint-plugins.ts"],
      "@zacatl/optionals": ["../src/utils/optionals.ts"],
      "@zacatl/*": ["../src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.d.ts"],
  "exclude": ["node_modules", "build", "coverage"]
}
